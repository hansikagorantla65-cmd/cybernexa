# ============================================
# CyberShield AI — Backend Environment Variables (FastAPI version)
# Copy this file, rename the copy to ".env", and fill in real values.
# Never upload the actual .env file to GitHub — only .env.example.
# ============================================

# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- CORS (which frontend is allowed to call this backend) ----
CLIENT_ORIGIN=http://localhost:3000

# ---- File uploads ----
MAX_UPLOAD_SIZE_MB=5
UPLOAD_TEMP_DIR=uploads/tmp

# ---- OCR service ----
# Leave blank for now — this prototype uses mock OCR output.
OCR_API_KEY=
OCR_API_URL=https://api.ocr.space/parse/image

# ---- Analysis behaviour ----
RISK_SCORE_WARNING_THRESHOLD=60
